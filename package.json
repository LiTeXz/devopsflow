{
  "name": "devopsflow",
  "version": "0.2.22",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "check:agent-instructions": "bun skills/df-agent-instruction-authoring/scripts/validate-agent-instructions.ts",
    "check:skill-metadata": "bun scripts/check-skill-metadata.ts",
    "test": "bun test",
    "test:hooks": "bun test scripts/",
    "test:validators": "bun test skills/df-tdd-skill/scripts/ skills/df-ddd-event-storming-design/scripts/ skills/df-iam-access-control-design/scripts/",
    "typecheck": "bunx tsc --noEmit",
    "format": "bunx biome format --write .",
    "format:check": "bunx biome format .",
    "lint": "bunx biome check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "^1.3.14",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  }
}
